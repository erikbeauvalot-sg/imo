# Copier en deploy/.env (jamais versionné) et compléter.

# --- Accès ----------------------------------------------------------------------------
# Nom de domaine du serveur : un enregistrement DNS A/AAAA doit pointer vers le VPS
IMV_DOMAIN=imv.exemple.com
# Adresse pour Let's Encrypt (avis d'expiration des certificats)
ACME_EMAIL=admin@exemple.com
# Ports publiés par Traefik (80 et 443 requis pour Let's Encrypt)
# HTTP_PORT=80
# HTTPS_PORT=443
# Fuseau horaire des heures affichées dans les résumés
# TZ=Europe/Paris

# --- LLM -------------------------------------------------------------------------------
# Fournisseur proposé par défaut : claude-cli, azure-openai, foundry, anthropic, ollama ; vide : pas
# d'analyse. Redémarrer IMV après un changement (docker compose up -d imv).
IMV_LLM=azure-openai
# claude-cli : votre abonnement Claude, jeton de « claude setup-token » (voir README.md)
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat…
# anthropic : clé d'API
# ANTHROPIC_API_KEY=sk-ant-api…
# hermes : agent Hermes du VPS (profil dédié), aussi pour « imv hermes <tâche> » (voir README.md)
# HERMES_API_KEY=<API_SERVER_KEY du profil Hermes>
# Puis les variables du fournisseur, comme dans ../.env.example, par exemple :
AZURE_FOUNDRY_ENDPOINT=https://<ressource>.services.ai.azure.com
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
OPENAI_MODEL=

# --- Telegram (essais sans Teams, voir ../README.md « Essais sur Telegram ») ----------------
# TELEGRAM_BOT_TOKEN=<jeton donné par @BotFather>
# TELEGRAM_ALLOWED_USERS=@mon_nom_telegram
# IMV_TELEGRAM_GROUP=SRE
# IMV_TELEGRAM_LANGUAGE=fr

# --- Agent -----------------------------------------------------------------------------
# IMV_IM=Erik Beauvalot
# IMV_NAME=IMV - Oscar
