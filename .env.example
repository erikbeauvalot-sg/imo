# Copier en .env (jamais versionné) et compléter. Les variables d'environnement déjà
# définies sont prioritaires sur ce fichier.

# --- Microsoft Foundry : adresse de la ressource -------------------------------------
# Adresse commune, utilisée par --llm foundry (Claude) et --llm azure-openai (GPT)
AZURE_FOUNDRY_ENDPOINT=https://<ressource>.services.ai.azure.com
# Variantes si les adresses diffèrent :
# ANTHROPIC_FOUNDRY_BASE_URL=https://<ressource>.services.ai.azure.com/anthropic/
# AZURE_OPENAI_ENDPOINT=https://<ressource>.openai.azure.com

# --- Authentification Entra ID (principal de service) ---------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Scope du jeton, si le défaut ne convient pas :
# AZURE_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
# Ou bien une clé d'API à la place d'Entra ID :
# ANTHROPIC_FOUNDRY_API_KEY=
# AZURE_OPENAI_API_KEY=

# --- Modèles (noms des déploiements) ----------------------------------------------------
OPENAI_MODEL=
# ANTHROPIC_FOUNDRY_MODEL=claude-opus-5-5
# OPENAI_API_VERSION=2024-10-21

# --- Agent ------------------------------------------------------------------------------
# Responsable d'IMV : nom exact affiché par Teams (sinon : première personne à taper une commande)
# IMV_IM=Erik Beauvalot
# Contexte de l'entreprise transmis au LLM (modèle : contexte.exemple.md)
# IMV_CONTEXT=contexte.md
# Navigateur : chromium, chrome ou msedge
# IMV_BROWSER=msedge
